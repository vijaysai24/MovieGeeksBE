PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=movie_geeks
DB_PASSWORD=
DB_NAME=movie_geeks

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Redis (optional: falls back to in-memory cache when unreachable)
