# External movie data
TMDB_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
DEFAULT_REGION=IN
# Optional: IMDb / Rotten Tomatoes / Metacritic ratings via https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
